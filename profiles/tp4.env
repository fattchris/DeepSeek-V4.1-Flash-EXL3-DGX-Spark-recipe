# TP4 on 4x DGX Spark (TP4 + EP4): the measured serving profile.
#
# The launch configuration of the measured TP4 deployment: 1M context, DSpark
# drafter k=2 with MXFP4 draft experts, decode-only CUDA graphs and disk-backed
# Engram. It needs the image from scripts/build_tp4_runtime.sh.
#
#   set -a; . profiles/tp4.env; set +a
#   bash scripts/start_disk_engram_cluster.sh head      # head Spark
#   bash scripts/start_disk_engram_cluster.sh worker    # the other three
#   bash scripts/serve_tp4.sh                           # head only
#
# configs/serve-tp4-live.yaml is the serve config captured from the measured
# deployment. Keep the two files in sync (tests enforce it).

IMAGE=deepseek-v41-exl3:tp4

# Snapshot path inside every container (host MODEL_DIR is mounted at /models).
MODEL=/models/DSV4.1-Flash-EXL3-4.75bpw
VLLM_ENGRAM_DISK_BACKED=1
VLLM_ENGRAM_MODEL_DIR=/models/DSV4.1-Flash-EXL3-4.75bpw

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
TEXT_ONLY=1
DSPARK=1
EAGER=0
NATIVE_MOE=0
MOE_PARALLEL_MODE=ep

# Manual KV budget. vLLM skips memory profiling when this is set, so
# GPU_MEMORY_UTILIZATION has no effect; it stays only to mirror the capture.
# 8 GiB = 2,454,802 KV tokens per the boot log. Raise it for more KV.
KV_CACHE_MEMORY_BYTES=8589934592
GPU_MEMORY_UTILIZATION=0.55

BLOCK_SIZE=128
PREFIX_CACHING=1

# DSpark: k=2 is the measured optimum on 4x GB10 (serve.sh default is 5).
NUM_SPECULATIVE_TOKENS=2
SPECULATIVE_QUANTIZATION=mxfp4

EXL3_MOE_KERNEL=native

# Decode-only CUDA graphs at the deployed batch shapes. Needs the
# tools/engram/engram_hoist.py fix, which is baked into the tp4 image.
COMPILATION_CONFIG='{"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[3,6,9,12]}'

# EXL3 execution tuning from the measured workers.
VLLM_EXL3_ALLOW_SHAPE_MISMATCH=1
VLLM_EXL3_TRELLIS_ARENA=1
VLLM_EXL3_ARENA_PRESCAN=1
VLLM_EXL3_PADDED_MAX_T=32
VLLM_EXL3_PADDED_MAX_K=6
VLLM_EXL3_NATIVE_MOE_MAX_ROWS=32
VLLM_EXL3_MADV_AFTER_H2D=0
VLLM_EXL3_PREFETCH=populate
VLLM_EXL3_PAD_SO_CB=2

EXTRA_VLLM_ARGS='--engram-config {"cpu_offload":false}'
