# Shared runtime image and cluster settings
IMAGE=deepseek-v41-exl3:spark
CONTAINER_NAME=dsv41-exl3
RAY_PORT=6379

# Leave runtime/component/model pins blank here. The authoritative values live in
# runtime.lock.json and are consumed automatically by build/preflight/serve.
BASE_IMAGE=
VLLM_EXL3_REF=
EXLLAMAV3_REF=
TORCH_CUDA_ARCH_LIST=
MODEL_TP4=
MODEL_TP2=
MODEL=
MODEL_REVISION=

# For a local checkpoint, mount the same host path on every node and set
# MODEL=/models/<dir>. Profiles in profiles/ set this for you.
MODEL_DIR=
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
HF_TOKEN=
SERVED_MODEL_NAME=deepseek-v41-exl3

# Conservative defaults when no profile is loaded. profiles/tp4.env is the
# measured TP4 configuration.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=1024
TEXT_ONLY=1
DSPARK=0
EAGER=1
NATIVE_MOE=0

# Explicit experimental escape hatches.
ALLOW_RUNTIME_OVERRIDE=0

# Set to 1 to print the exact vLLM command and exit before model load.
DRY_RUN=0

# API
HOST=0.0.0.0
PORT=8000
