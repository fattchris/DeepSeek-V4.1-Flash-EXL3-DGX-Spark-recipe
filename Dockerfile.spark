ARG BASE_IMAGE=vllm/vllm-openai:deepseekv41-flash-0909
FROM ${BASE_IMAGE}

ARG BASE_IMAGE=vllm/vllm-openai:deepseekv41-flash-0909
ARG VLLM_EXL3_REF=21fa627a3933d80de2d1030e732354d8c3cd761e
ARG EXLLAMAV3_REF=be57335b087e4f001c5caae061544df3c06ba01e
ARG TORCH_CUDA_ARCH_LIST=12.1a

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=2 \
    VLLM_EXL3_REF=${VLLM_EXL3_REF} \
    EXLLAMAV3_REF=${EXLLAMAV3_REF} \
    RECIPE_BASE_IMAGE=${BASE_IMAGE}

USER root


RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential ninja-build ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# DGX Spark base image lacks 'python' command (has python3 only)
RUN if ! command -v python >/dev/null 2>&1; then ln -sf /usr/bin/python3 /usr/local/bin/python; fi

# Keep the dedicated V4.1 vLLM package from the base image intact.
RUN python - <<'PY'
import sys
assert sys.version_info >= (3, 12), sys.version
import vllm
print("base vLLM:", vllm.__version__)
PY

RUN python -m pip install --no-cache-dir --upgrade "setuptools>=77" wheel ninja \
    && python -m pip install --no-cache-dir "ray[cgraph]" huggingface_hub

RUN git clone https://github.com/vcruz305/vllm-exl3.git /opt/vllm-exl3 \
    && git -C /opt/vllm-exl3 checkout --detach ${VLLM_EXL3_REF} \
    && test "$(git -C /opt/vllm-exl3 rev-parse HEAD)" = "${VLLM_EXL3_REF}"

RUN git clone https://github.com/turboderp-org/exllamav3.git /opt/exllamav3 \
    && git -C /opt/exllamav3 checkout --detach ${EXLLAMAV3_REF} \
    && test "$(git -C /opt/exllamav3 rev-parse HEAD)" = "${EXLLAMAV3_REF}"

# The patch is idempotent and only needed on aarch64. Keep x86 builds untouched.
RUN if [ "$(uname -m)" = "aarch64" ]; then \
      python /opt/vllm-exl3/tools/patch_exllamav3_aarch64.py \
        /opt/exllamav3/exllamav3/exllamav3_ext --force; \
    fi

# ExLlamaV3 needs cusparse.h; discover and set CPATH in the same RUN
# (CPATH written to /etc/environment is NOT sourced by later Docker RUNs)
RUN CUSPARSE_DIR=$(find /usr/local/lib/python3*/dist-packages/nvidia -name cusparse.h -exec dirname {} \; 2>/dev/null | head -1) \
    && export CPATH="${CUSPARSE_DIR:+$CUSPARSE_DIR:}${CPATH:-}" \
    && python -m pip install --no-cache-dir --no-build-isolation /opt/exllamav3

ENV EXL3_EXT_INCLUDE=/opt/exllamav3/exllamav3/exllamav3_ext
RUN unset VLLM_EXL3_NO_CUDA \
    && python -m pip install --no-cache-dir --no-build-isolation --no-deps /opt/vllm-exl3

RUN python - <<'PY'
import vllm
import vllm_exl3
import vllm_exl3_c
vllm_exl3.register()
abi = int(getattr(vllm_exl3_c, "P2B_MOE_ABI_VERSION", 0))
diag = vllm_exl3.runtime_diagnostics()
assert abi >= 3, f"expected EXL3 native MoE ABI >= 3, got {abi}"
assert diag["mixed_k"]["config_bits"] == [2, 3, 4, 5, 6, 7, 8], diag["mixed_k"]
assert diag["mixed_k"]["exllamav3_moe_kernel_bits"] == [1, 2, 3, 4, 5, 6, 7, 8], diag["mixed_k"]
assert diag["mixed_k"]["native_qualified_bits"] == [2, 3, 4], diag["mixed_k"]
assert diag["mixed_k"]["tensor_level_mixed_k_within_layer"] is False
plan2 = vllm_exl3.plan_deepseek_v41(tensor_parallel_size=2, expert_parallel=True)
assert plan2.local_experts == 192
assert plan2.preferred_first_boot_backend == "exllamav3"
print("vLLM:", vllm.__version__)
print("vllm-exl3 ABI:", abi)
print("TP2 plan:", plan2.to_dict())
print("TORCH_CUDA_ARCH_LIST build target is provided by the image environment")
print(diag)
PY

WORKDIR /workspace
