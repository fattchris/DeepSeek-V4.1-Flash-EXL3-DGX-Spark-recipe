ARG BASE_IMAGE=vllm/vllm-openai:deepseekv41-flash-0909
FROM ${BASE_IMAGE}

ARG BASE_IMAGE=vllm/vllm-openai:deepseekv41-flash-0909
ARG VLLM_EXL3_REF=814d4fe38082cddd838b45418c7d13a95395a36a
ARG VLLM_EXL3_REPO=https://github.com/vcruz305/vllm-exl3.git
ARG EXLLAMAV3_REF=be57335b087e4f001c5caae061544df3c06ba01e
ARG TORCH_CUDA_ARCH_LIST=12.1a

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=2 \
    VLLM_EXL3_REF=${VLLM_EXL3_REF} \
    VLLM_EXL3_REPO=${VLLM_EXL3_REPO} \
    EXLLAMAV3_REF=${EXLLAMAV3_REF} \
    RECIPE_BASE_IMAGE=${BASE_IMAGE}

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential ninja-build ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# GB10's dedicated V4.1 base image may expose python3 without a python alias.
RUN if ! command -v python >/dev/null 2>&1; then \
      ln -sf "$(command -v python3)" /usr/local/bin/python; \
    fi

# Keep the dedicated V4.1 vLLM package from the base image intact.
RUN python - <<'PY'
import sys
assert sys.version_info >= (3, 12), sys.version
import vllm
print("base vLLM:", vllm.__version__)
PY

RUN python -m pip install --no-cache-dir --upgrade "setuptools>=77" wheel ninja \
    && python -m pip install --no-cache-dir "ray[cgraph]" huggingface_hub

RUN git clone ${VLLM_EXL3_REPO} /opt/vllm-exl3 \
    && git -C /opt/vllm-exl3 checkout --detach ${VLLM_EXL3_REF} \
    && test "$(git -C /opt/vllm-exl3 rev-parse HEAD)" = "${VLLM_EXL3_REF}"

RUN git clone https://github.com/turboderp-org/exllamav3.git /opt/exllamav3 \
    && git -C /opt/exllamav3 checkout --detach ${EXLLAMAV3_REF} \
    && test "$(git -C /opt/exllamav3 rev-parse HEAD)" = "${EXLLAMAV3_REF}"

# The patch is idempotent and only needed on aarch64. Keep x86 builds untouched.
RUN if [ "$(uname -m)" = "aarch64" ]; then \
      python /opt/vllm-exl3/tools/patch_exllamav3_aarch64.py \
        /opt/exllamav3/exllamav3/exllamav3_ext --force; \
    fi

# ExLlamaV3's CUDA build needs cusparse.h. Discover the NVIDIA Python-package
# include path dynamically so CUDA 13 package layouts are not hard-coded.
ENV EXL3_EXT_INCLUDE=/opt/exllamav3/exllamav3/exllamav3_ext
RUN CUSPARSE_DIR="$(find /usr/local/lib/python3*/dist-packages/nvidia -name cusparse.h -exec dirname {} \; 2>/dev/null | head -1)" \
    && if [ -z "$CUSPARSE_DIR" ]; then \
         echo "ERROR: cusparse.h not found under NVIDIA Python packages" >&2; exit 2; \
       fi \
    && export CPATH="$CUSPARSE_DIR${CPATH:+:$CPATH}" \
    && python -m pip install --no-cache-dir --no-build-isolation /opt/exllamav3 \
    && unset VLLM_EXL3_NO_CUDA \
    && python -m pip install --no-cache-dir --no-build-isolation --no-deps /opt/vllm-exl3

RUN python - <<'PY'
import vllm
import vllm_exl3
import vllm_exl3_c
from vllm_exl3.v41_context import estimate_v41_kv_cache, plan_v41_moe_topologies
vllm_exl3.register()
abi = int(getattr(vllm_exl3_c, "P2B_MOE_ABI_VERSION", 0))
diag = vllm_exl3.runtime_diagnostics()
assert abi >= 3, f"expected EXL3 native MoE ABI >= 3, got {abi}"
assert diag["mixed_k"]["config_bits"] == [2, 3, 4, 5, 6, 7, 8], diag["mixed_k"]
assert diag["mixed_k"]["exllamav3_moe_kernel_bits"] == [1, 2, 3, 4, 5, 6, 7, 8], diag["mixed_k"]
assert diag["mixed_k"]["native_qualified_bits"] == [2, 3, 4], diag["mixed_k"]
assert diag["mixed_k"]["tensor_level_mixed_k_within_layer"] is True, diag["mixed_k"]
assert diag["mixed_k"]["heterogeneous_dispatch"] == "python_loop", diag["mixed_k"]
assert diag["mixed_k"]["fused_k_source"] == "physical_trellis_geometry", diag["mixed_k"]
assert diag["mixed_k"]["physical_fused_k_guard_installed"] is True, diag["mixed_k"]
assert diag["mixed_k"]["cudagraph_qualified"] is False, diag["mixed_k"]
assert diag["mixed_k"]["arena_prescan_guard_installed"] is True, diag["mixed_k"]
assert getattr(__import__("vllm_exl3.exl3", fromlist=["x"]), "_vllm_exl3_mixed_k_prescan_tp_aware", False) is True
assert diag["tp_geometry"]["nested_moe_config_compat_installed"] is True, diag["tp_geometry"]
plan2 = vllm_exl3.plan_deepseek_v41(tensor_parallel_size=2, expert_parallel=True)
assert plan2.local_experts == 192
assert plan2.preferred_first_boot_backend == "exllamav3"
topo2 = plan_v41_moe_topologies(2)
assert topo2["pure_moe_tp"]["expert_intermediate_local"] == 1152
assert topo2["pure_moe_tp"]["padded_intermediate_128"] == 1152
kv = estimate_v41_kv_cache(131072)
assert kv["logical_bytes_per_token"] == 890
assert kv["capacity_qualified"] is False
print("vLLM:", vllm.__version__)
print("vllm-exl3 ABI:", abi)
print("TP2 EP plan:", plan2.to_dict())
print("TP2 MoE topology A/B:", topo2)
print("V4.1 logical KV receipt:", kv)
print("TORCH_CUDA_ARCH_LIST build target is provided by the image environment")
print(diag)
PY

WORKDIR /workspace
